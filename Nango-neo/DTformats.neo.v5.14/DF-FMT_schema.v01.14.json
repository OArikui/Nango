{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nango-neo DTformats.neo.v5.14",
  "description": "Canonical dictionary format. Word keys contain headwords only; readings are stored separately in reading and foreign spellings in english. Do not append readings in parentheses to word names.",
  "type": "object",
  "required": [
    "words"
  ],
  "properties": {
    "words": {
      "type": "object",
      "description": "Dictionary keyed by the display word. The key is the word itself, not a word/any field.",
      "additionalProperties": {
        "$ref": "#/$defs/word"
      }
    },
    "additional_data": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": true,
  "$defs": {
    "word": {
      "type": "object",
      "required": [
        "meanings"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Assigned by Nango on import/add."
        },
        "datetime": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 date-time."
        },
        "category": {
          "type": "string"
        },
        "eraTag": {
          "type": "string"
        },
        "reading": {
          "type": "string",
          "description": "Japanese reading stored separately; do not append it to the display word in parentheses."
        },
        "kanji": {
          "type": "string"
        },
        "english": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "memo": {
          "type": "string"
        },
        "gemini_note": {
          "type": "string"
        },
        "other_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of related tags; one independent tag per item. A middle dot may remain inside an item when it is part of a proper name or term."
        },
        "meanings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/meaning"
          }
        }
      },
      "additionalProperties": true,
      "description": "A word entry. The word key is the headword only; reading belongs in reading, and original foreign spelling belongs in english."
    },
    "meaning": {
      "type": "object",
      "required": [
        "definition"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "nuance": {
          "type": "string"
        },
        "fieldTag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of independent domain tags, one tag per item. Do not concatenate multiple tags with the Japanese middle dot (・); use separate array items."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
